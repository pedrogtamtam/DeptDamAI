@page "/Assets"
@using DeptDam.Models
@using DeptDam.Data
@using DeptDam.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject DeptDam.Services.IBrandingService BrandingService
@inject IAssetService AssetService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Asset Library — Search & Discovery</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold">@branding.PageAssetsHeading</h1>
        <p class="text-secondary small mb-0">
            @if (!string.IsNullOrWhiteSpace(branding.PageAssetsSubheading))
            {
                <span>@branding.PageAssetsSubheading</span>
                @if (assets != null) { <span class="mx-1">·</span> }
            }
            @if (assets != null)
            {
                <span>@assets.Count of @TotalCount assets</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm @(selectionMode ? "active" : "")" @onclick="ToggleSelectionMode" title="Select assets for bulk actions">
            <i class="bi bi-check2-square me-1"></i>Select
            @if (selectedAssetIds.Any())
            {
                <span class="badge bg-primary ms-1">@selectedAssetIds.Count</span>
            }
        </button>
        <button class="btn btn-outline-secondary btn-sm @(ShowFilters ? "active" : "")" @onclick="ToggleFilters">
            <i class="bi bi-sliders me-1"></i>Filters
            @if (HasActiveFilters)
            {
                <span class="badge bg-primary ms-1">@ActiveFilterCount</span>
            }
        </button>
        <PermissionView Permission="@AppPermissions.AssetsUpload">
            <a href="/Assets/Upload" class="btn btn-primary px-4 d-flex align-items-center">
                <i class="bi bi-upload me-2"></i> Upload
            </a>
        </PermissionView>
    </div>
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex gap-2 align-items-center">
            <div class="input-group input-group-lg flex-grow-1">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input id="searchInput" class="form-control border-start-0 ps-0 fs-6" type="search"
                       placeholder="Search by filename, tag, OCR text, or metadata…"
                       @bind="SearchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp"
                       @onfocus="() => showSuggestions = suggestions.Any()"
                       @onblur="() => Task.Delay(200).ContinueWith(_ => InvokeAsync(() => showSuggestions = false))" />
                @if (!string.IsNullOrEmpty(SearchQuery))
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
                <button class="btn btn-primary" @onclick="SearchAssets">Search</button>
            </div>

            @if (showSuggestions && suggestions.Any())
            {
                <div class="position-relative w-100">
                    <ul class="list-group shadow position-absolute w-100" style="z-index:1000; top:2px; max-height:260px; overflow-y:auto;">
                        @foreach (var s in suggestions)
                        {
                            <li class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 px-3 small"
                                @onmousedown="() => ApplySuggestion(s)" style="cursor:pointer;">
                                <i class="bi @(s.Type == "tag" ? "bi-tag-fill text-primary" : "bi-file-earmark text-secondary") flex-shrink-0"></i>
                                <span class="text-truncate">@s.Label</span>
                                <span class="badge bg-secondary-subtle text-secondary ms-auto text-uppercase">@s.Type</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(ActiveSearchQuery))
        {
            <div class="mt-2 d-flex align-items-center gap-2">
                <small class="text-muted">Results for</small>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    @ActiveSearchQuery 
                    <button type="button" class="btn-close btn-close-sm ms-1" style="font-size:0.5rem;" @onclick="ClearSearch"></button>
                </span>
                @if (assets != null)
                {
                    <small class="text-muted">— @assets.Count result@(assets.Count == 1 ? "" : "s")</small>
                }
                <button class="btn btn-link btn-sm text-decoration-none ms-auto p-0" @onclick="SaveSearch">
                    <i class="bi bi-bookmark-plus me-1"></i>Save Search
                </button>
            </div>
        }
    </div>
</div>

<!-- Faceted Filters Panel -->
@if (ShowFilters)
{
    <div class="card border-0 shadow-sm mb-3 border-top border-primary border-3">
        <div class="card-body">
            <div class="row g-3">
                
                <!-- File Type -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">FILE TYPE</label>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var ft in FileTypeOptions)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ft_@ft.Key"
                                       checked="@SelectedFileTypes.Contains(ft.Key)"
                                       @onchange="e => ToggleFileType(ft.Key, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small" for="ft_@ft.Key">
                                    <i class="bi @ft.Value.Icon me-1 text-muted"></i>@ft.Value.Label
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tags -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">TAGS</label>
                    <div class="d-flex flex-column gap-1" style="max-height:150px; overflow-y:auto;">
                        @foreach (var tag in AllTags.Take(20))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="tag_@tag.Id"
                                       checked="@SelectedTagIds.Contains(tag.Id)"
                                       @onchange="e => ToggleTag(tag.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small" for="tag_@tag.Id">@tag.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Status -->
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">WORKFLOW STATUS</label>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var state in Enum.GetValues<AssetWorkflowState>())
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ws_@state"
                                       checked="@SelectedStates.Contains(state)"
                                       @onchange="e => ToggleState(state, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small" for="ws_@state">@state</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Date Range -->
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">UPLOADED</label>
                    <select class="form-select form-select-sm" @bind="DateRangeFilter" @bind:after="SearchAssets">
                        <option value="">Any time</option>
                        <option value="today">Today</option>
                        <option value="7d">Last 7 days</option>
                        <option value="30d">Last 30 days</option>
                        <option value="90d">Last 90 days</option>
                        <option value="year">This year</option>
                    </select>
                </div>

                <!-- Sort -->
                <div class="col-md-2">
                    <label class="form-label text-muted small fw-bold">SORT BY</label>
                    <select class="form-select form-select-sm" @bind="SortBy" @bind:after="SearchAssets">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                        <option value="name_asc">Name A→Z</option>
                        <option value="name_desc">Name Z→A</option>
                        <option value="size_desc">Largest first</option>
                        <option value="size_asc">Smallest first</option>
                    </select>
                </div>

                <!-- Uploader -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">UPLOADED BY</label>
                    <div class="d-flex flex-column gap-1" style="max-height:120px; overflow-y:auto;">
                        @foreach (var uploader in AllUploaders)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="up_@uploader.Id"
                                       checked="@SelectedUploaderIds.Contains(uploader.Id)"
                                       @onchange="e => ToggleUploader(uploader.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-truncate" for="up_@uploader.Id">@(uploader.UserName ?? uploader.Email)</label>
                            </div>
                        }
                    </div>
                </div>

                <!-- Collection -->
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">COLLECTION</label>
                    <div class="d-flex flex-column gap-1" style="max-height:120px; overflow-y:auto;">
                        @foreach (var col in AllCollections)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="col_@col.Id"
                                       checked="@SelectedCollectionIds.Contains(col.Id)"
                                       @onchange="e => ToggleCollection(col.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-truncate" for="col_@col.Id">@col.Name</label>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">
                    <i class="bi bi-x-circle me-1"></i>Reset
                </button>
            </div>
        </div>
    </div>
}

<!-- Saved Searches -->
@if (SavedSearches.Any())
{
    <div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
        <small class="text-muted fw-bold"><i class="bi bi-bookmark me-1"></i>Saved:</small>
        @foreach (var s in SavedSearches)
        {
            <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => RestoreSavedSearch(s)">
                @s.Name
            </button>
            <button class="btn btn-sm btn-link text-danger p-0" title="Remove" @onclick="() => RemoveSavedSearch(s)">
                <i class="bi bi-x"></i>
            </button>
        }
    </div>
}

<!-- Save Search Dialog -->
@if (ShowSaveSearchDialog)
{
    <div class="modal-backdrop-inline card border-primary shadow-sm mb-3 border-2">
        <div class="card-body d-flex gap-2 align-items-center">
            <i class="bi bi-bookmark-fill text-primary fs-5"></i>
            <input type="text" class="form-control form-control-sm" placeholder="Name this search…" @bind="SaveSearchName" @bind:event="oninput" />
            <button class="btn btn-sm btn-primary" @onclick="ConfirmSaveSearch" disabled="@string.IsNullOrWhiteSpace(SaveSearchName)">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowSaveSearchDialog = false">Cancel</button>
        </div>
    </div>
}

@* ── Bulk action toolbar ───────────────────────────────────────────────────── *@
@if (selectionMode && selectedAssetIds.Any())
{
    <div class="card border-0 shadow-sm mb-3 border-start border-primary border-3">
        <div class="card-body py-2 px-4 d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold me-1">@selectedAssetIds.Count selected</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAll">
                <i class="bi bi-check2-all me-1"></i>All @TotalCount
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAll">
                <i class="bi bi-x me-1"></i>Deselect
            </button>
            <div class="vr mx-1"></div>

            @* Bulk Tag *@
            <div class="input-group input-group-sm" style="width:220px;">
                <input type="text" class="form-control" placeholder="Tag name…" @bind="bulkTagName" />
                <button class="btn btn-outline-primary" @onclick="BulkTag" disabled="@string.IsNullOrWhiteSpace(bulkTagName)">
                    <i class="bi bi-tag me-1"></i>Tag
                </button>
            </div>

            @* Bulk Move to Collection *@
            <div class="input-group input-group-sm" style="width:220px;">
                <select class="form-select" @bind="bulkCollectionId">
                    <option value="">Move to collection…</option>
                    @foreach (var col in AllCollections)
                    {
                        <option value="@col.Id">@col.Name</option>
                    }
                </select>
                <button class="btn btn-outline-primary" @onclick="BulkMoveToCollection" disabled="@string.IsNullOrWhiteSpace(bulkCollectionId)">
                    <i class="bi bi-collection me-1"></i>Move
                </button>
            </div>

            @* Bulk Workflow State *@
            <div class="input-group input-group-sm" style="width:200px;">
                <select class="form-select" @bind="bulkWorkflowState">
                    <option value="">Set status…</option>
                    @foreach (var state in Enum.GetValues<AssetWorkflowState>())
                    {
                        <option value="@state">@state</option>
                    }
                </select>
                <button class="btn btn-outline-warning" @onclick="BulkSetState" disabled="@string.IsNullOrWhiteSpace(bulkWorkflowState)">
                    <i class="bi bi-kanban me-1"></i>Set
                </button>
            </div>

            @* Bulk Download ZIP *@
            <button class="btn btn-sm btn-outline-success" @onclick="BulkDownloadZip">
                <i class="bi bi-file-zip me-1"></i>Download ZIP
            </button>
        </div>
    </div>
}

<!-- Results Grid -->
@if (assets == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (assets.Count == 0)
{
    <div class="text-center py-5 bg-light rounded-4 border border-dashed">
        <i class="bi bi-images display-1 text-muted opacity-25 mb-4"></i>
        <h4 class="fw-bold">No assets found</h4>
        @if (HasActiveFilters || !string.IsNullOrEmpty(ActiveSearchQuery))
        {
            <p class="text-secondary mb-4">Try adjusting your search or filters.</p>
            <button class="btn btn-outline-secondary me-2" @onclick="ResetAll">Clear All Filters</button>
        }
        <a href="/Assets/Upload" class="btn btn-primary">Upload First Asset</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        @foreach (var asset in assets)
        {
            <div class="col">
                <AssetCard Asset="asset" SearchTerms="@ActiveSearchQuery"
                           ShowCheckbox="selectionMode"
                           IsSelected="@selectedAssetIds.Contains(asset.Id)"
                           OnSelectionChanged="@(v => ToggleAssetSelection(asset.Id, v))" />
            </div>
        }
    </div>

    @if (assets.Count < TotalCount)
    {
        <div class="text-center">
            <button class="btn btn-outline-primary px-5" @onclick="LoadMore">
                <i class="bi bi-chevron-down me-1"></i>Load more (@(TotalCount - assets.Count) remaining)
            </button>
        </div>
    }
}

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .border-dashed { border-style: dashed !important; }
    .modal-backdrop-inline { animation: fadeIn 0.2s ease; }
</style>

@code {
    private DeptDam.Models.BrandingSettings branding = new();
    private List<Asset>? assets;

    // ── Selection / Bulk ─────────────────────────────────────────────────────
    private bool selectionMode;
    private HashSet<string> selectedAssetIds = new();
    private string bulkTagName = "";
    private string bulkCollectionId = "";
    private string bulkWorkflowState = "";
    private int TotalCount;
    private int PageSize = 24;
    private int CurrentPage = 1;

    // Search
    private string SearchQuery { get; set; } = string.Empty;
    private string ActiveSearchQuery { get; set; } = string.Empty;

    // Filters
    private bool ShowFilters = false;
    private HashSet<string> SelectedFileTypes = new();
    private HashSet<string> SelectedTagIds = new();
    private HashSet<AssetWorkflowState> SelectedStates = new();
    private string DateRangeFilter = string.Empty;
    private string SortBy = "newest";

    // Tags
    private List<Tag> AllTags = new();

    // ── Uploader / Collection facets ─────────────────────────────────────────
    private List<Data.ApplicationUser> AllUploaders = new();
    private List<Collection> AllCollections = new();
    private HashSet<string> SelectedUploaderIds = new();
    private HashSet<string> SelectedCollectionIds = new();

    // ── Search suggestions ───────────────────────────────────────────────────
    private List<SearchSuggestion> suggestions = new();
    private bool showSuggestions;

    // Saved searches
    private bool ShowSaveSearchDialog = false;
    private string SaveSearchName = string.Empty;
    private List<SavedSearch> SavedSearches = new();

    private bool HasActiveFilters =>
        SelectedFileTypes.Any() || SelectedTagIds.Any() || SelectedStates.Any() ||
        !string.IsNullOrEmpty(DateRangeFilter) || SelectedUploaderIds.Any() || SelectedCollectionIds.Any();
    private int ActiveFilterCount =>
        SelectedFileTypes.Count + SelectedTagIds.Count + SelectedStates.Count +
        (string.IsNullOrEmpty(DateRangeFilter) ? 0 : 1) + SelectedUploaderIds.Count + SelectedCollectionIds.Count;

    private static readonly Dictionary<string, (string Icon, string Label, string[] Prefixes)> FileTypeOptions = new()
    {
        ["image"] = ("bi-image", "Images", new[] { "image/" }),
        ["video"] = ("bi-film", "Videos", new[] { "video/" }),
        ["audio"] = ("bi-music-note-beamed", "Audio", new[] { "audio/" }),
        ["document"] = ("bi-file-earmark-text", "Documents", new[] { "application/pdf", "application/msword", "application/vnd" }),
    };

    protected override async Task OnInitializedAsync()
    {
        branding = await BrandingService.GetAsync();
        BrandingService.OnChanged += HandleBrandingChanged;
        AllTags = await DbContext.Tags.OrderBy(t => t.Name).ToListAsync();
        AllUploaders = await DbContext.Users.OrderBy(u => u.UserName).ToListAsync();
        AllCollections = await DbContext.Collections.OrderBy(c => c.Name).ToListAsync();
        await LoadAssetsAsync();
    }

    private void HandleBrandingChanged(DeptDam.Models.BrandingSettings updated)
    {
        branding = updated;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BrandingService.OnChanged -= HandleBrandingChanged;
    }

    private async Task LoadAssetsAsync(bool append = false)
    {
        var query = DbContext.Assets
            .Include(a => a.Tags).ThenInclude(at => at.Tag)
            .AsQueryable();

        // Full-text search across filename, OCR, EXIF, and tags
        if (!string.IsNullOrWhiteSpace(ActiveSearchQuery))
        {
            var term = ActiveSearchQuery.ToLower();
            query = query.Where(a =>
                a.OriginalFileName.ToLower().Contains(term) ||
                (a.ExtractedText != null && a.ExtractedText.ToLower().Contains(term)) ||
                (a.ExifData != null && a.ExifData.ToLower().Contains(term)) ||
                a.Tags.Any(t => t.Tag != null && t.Tag.Name.ToLower().Contains(term)));
        }

        // File type facet
        if (SelectedFileTypes.Any())
        {
            var prefixes = SelectedFileTypes
                .SelectMany(ft => FileTypeOptions.TryGetValue(ft, out var val) ? val.Prefixes : Array.Empty<string>())
                .ToList();

            if (prefixes.Any())
            {
                // Most modern EF Core versions can translate localList.Any(p => dbProp.StartsWith(p)) 
                // into a series of LIKE clauses in SQL.
                query = query.Where(a => prefixes.Any(p => a.ContentType.StartsWith(p)));
            }
        }




        // Tag facet
        if (SelectedTagIds.Any())
        {
            foreach (var tid in SelectedTagIds)
                query = query.Where(a => a.Tags.Any(at => at.TagId == tid));
        }

        // Workflow state facet
        if (SelectedStates.Any())
            query = query.Where(a => SelectedStates.Contains(a.WorkflowState));

        // Date range facet
        if (!string.IsNullOrEmpty(DateRangeFilter))
        {
            var cutoff = DateRangeFilter switch
            {
                "today" => DateTime.UtcNow.Date,
                "7d"    => DateTime.UtcNow.AddDays(-7),
                "30d"   => DateTime.UtcNow.AddDays(-30),
                "90d"   => DateTime.UtcNow.AddDays(-90),
                "year"  => new DateTime(DateTime.UtcNow.Year, 1, 1),
                _       => DateTime.MinValue
            };
            query = query.Where(a => a.UploadedAt >= cutoff);
        }

        // Uploader facet
        if (SelectedUploaderIds.Any())
            query = query.Where(a => SelectedUploaderIds.Contains(a.UploadedById));

        // Collection facet
        if (SelectedCollectionIds.Any())
            query = query.Where(a => DbContext.CollectionAssets
                .Any(ca => SelectedCollectionIds.Contains(ca.CollectionId) && ca.AssetId == a.Id));

        TotalCount = await query.CountAsync();

        // Sorting
        query = SortBy switch
        {
            "oldest"    => query.OrderBy(a => a.UploadedAt),
            "name_asc"  => query.OrderBy(a => a.OriginalFileName),
            "name_desc" => query.OrderByDescending(a => a.OriginalFileName),
            "size_desc" => query.OrderByDescending(a => a.SizeBytes),
            "size_asc"  => query.OrderBy(a => a.SizeBytes),
            _           => query.OrderByDescending(a => a.UploadedAt)
        };

        var fetched = await query.Take(PageSize * CurrentPage).ToListAsync();
        assets = fetched; // Always replace since we use Take(PageSize * CurrentPage) which includes previous items
    }


    private async Task LoadMore()
    {
        CurrentPage++;
        await LoadAssetsAsync(append: true);
    }

    private async Task SearchAssets()
    {
        ActiveSearchQuery = SearchQuery;
        CurrentPage = 1;
        await LoadAssetsAsync();
    }

    private async Task ClearSearch()
    {
        SearchQuery = string.Empty;
        ActiveSearchQuery = string.Empty;
        CurrentPage = 1;
        await LoadAssetsAsync();
    }

    private void ToggleFilters() => ShowFilters = !ShowFilters;

    private async Task ToggleFileType(string key, bool on)
    {
        if (on) SelectedFileTypes.Add(key); else SelectedFileTypes.Remove(key);
        await SearchAssets();
    }

    private async Task ToggleTag(string tagId, bool on)
    {
        if (on) SelectedTagIds.Add(tagId); else SelectedTagIds.Remove(tagId);
        await SearchAssets();
    }

    private async Task ToggleState(AssetWorkflowState state, bool on)
    {
        if (on) SelectedStates.Add(state); else SelectedStates.Remove(state);
        await SearchAssets();
    }

    private async Task ResetFilters()
    {
        SelectedFileTypes.Clear();
        SelectedTagIds.Clear();
        SelectedStates.Clear();
        SelectedUploaderIds.Clear();
        SelectedCollectionIds.Clear();
        DateRangeFilter = string.Empty;
        SortBy = "newest";
        await SearchAssets();
    }

    private async Task ResetAll()
    {
        await ResetFilters();
        await ClearSearch();
    }

    private async Task ToggleUploader(string id, bool on)
    {
        if (on) SelectedUploaderIds.Add(id); else SelectedUploaderIds.Remove(id);
        await SearchAssets();
    }

    private async Task ToggleCollection(string id, bool on)
    {
        if (on) SelectedCollectionIds.Add(id); else SelectedCollectionIds.Remove(id);
        await SearchAssets();
    }

    // ── Search suggestions ───────────────────────────────────────────────────
    private System.Threading.CancellationTokenSource? _suggestCts;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { showSuggestions = false; await SearchAssets(); return; }
        if (e.Key == "Escape") { showSuggestions = false; return; }
        await LoadSuggestionsAsync(SearchQuery);
    }

    private async Task LoadSuggestionsAsync(string q)
    {
        _suggestCts?.Cancel();
        _suggestCts = new System.Threading.CancellationTokenSource();
        var token = _suggestCts.Token;

        try
        {
            await Task.Delay(200, token); // debounce
        }
        catch (OperationCanceledException)
        {
            return; // superseded by a newer keystroke
        }

        if (string.IsNullOrWhiteSpace(q) || q.Length < 2)
        {
            suggestions.Clear();
            showSuggestions = false;
            return;
        }

        var term = q.ToLower();

        var assetHits = await DbContext.Assets
            .Where(a => a.OriginalFileName.ToLower().Contains(term))
            .OrderByDescending(a => a.UploadedAt).Take(5)
            .Select(a => new SearchSuggestion { Label = a.OriginalFileName, Type = "asset", Id = a.Id })
            .ToListAsync(token);

        var tagHits = await DbContext.Tags
            .Where(t => t.Name.ToLower().Contains(term)).Take(3)
            .Select(t => new SearchSuggestion { Label = t.Name, Type = "tag", Id = t.Id })
            .ToListAsync(token);

        suggestions = assetHits.Concat(tagHits).Take(8).ToList();
        showSuggestions = suggestions.Any();
    }

    private async Task ApplySuggestion(SearchSuggestion s)
    {
        showSuggestions = false;
        SearchQuery = s.Label;
        await SearchAssets();
    }

    // ── Selection helpers ────────────────────────────────────────────────────
    private void ToggleSelectionMode()
    {
        selectionMode = !selectionMode;
        if (!selectionMode) selectedAssetIds.Clear();
    }

    private void ToggleAssetSelection(string id, bool selected)
    {
        if (selected) selectedAssetIds.Add(id);
        else selectedAssetIds.Remove(id);
    }

    private void SelectAll()
    {
        if (assets != null)
            foreach (var a in assets) selectedAssetIds.Add(a.Id);
    }

    private void DeselectAll() => selectedAssetIds.Clear();

    // ── Bulk actions ─────────────────────────────────────────────────────────
    private async Task BulkTag()
    {
        if (string.IsNullOrWhiteSpace(bulkTagName) || !selectedAssetIds.Any()) return;
        await AssetService.BulkAddTagAsync(selectedAssetIds, bulkTagName.Trim());
        bulkTagName = "";
        await LoadAssetsAsync();
    }

    private async Task BulkMoveToCollection()
    {
        if (string.IsNullOrWhiteSpace(bulkCollectionId) || !selectedAssetIds.Any()) return;
        await AssetService.BulkMoveToCollectionAsync(selectedAssetIds, bulkCollectionId);
        bulkCollectionId = "";
        await LoadAssetsAsync();
    }

    private async Task BulkSetState()
    {
        if (string.IsNullOrWhiteSpace(bulkWorkflowState) || !selectedAssetIds.Any()) return;
        if (!Enum.TryParse<AssetWorkflowState>(bulkWorkflowState, out var state)) return;
        await AssetService.BulkSetWorkflowStateAsync(selectedAssetIds, state);
        bulkWorkflowState = "";
        await LoadAssetsAsync();
    }

    private async Task BulkDownloadZip()
    {
        if (!selectedAssetIds.Any()) return;
        var ids = string.Join(",", selectedAssetIds);
        await JS.InvokeVoidAsync("open", $"/api/media/bulk-download?ids={ids}", "_blank");
    }

    public class SearchSuggestion
    {
        public string Label { get; set; } = string.Empty;
        public string Type  { get; set; } = string.Empty;
        public string Id    { get; set; } = string.Empty;
    }
    private void SaveSearch()
    {
        ShowSaveSearchDialog = true;
        SaveSearchName = ActiveSearchQuery;
    }

    private void ConfirmSaveSearch()
    {
        if (string.IsNullOrWhiteSpace(SaveSearchName)) return;
        SavedSearches.Add(new SavedSearch
        {
            Name = SaveSearchName,
            Query = ActiveSearchQuery,
            FileTypes = SelectedFileTypes.ToList(),
            TagIds = SelectedTagIds.ToList(),
            States = SelectedStates.ToList(),
            DateRange = DateRangeFilter,
            Sort = SortBy
        });
        ShowSaveSearchDialog = false;
        SaveSearchName = string.Empty;
    }

    private async Task RestoreSavedSearch(SavedSearch s)
    {
        SearchQuery = s.Query;
        ActiveSearchQuery = s.Query;
        SelectedFileTypes = s.FileTypes.ToHashSet();
        SelectedTagIds = s.TagIds.ToHashSet();
        SelectedStates = s.States.ToHashSet();
        DateRangeFilter = s.DateRange;
        SortBy = s.Sort;
        ShowFilters = HasActiveFilters;
        CurrentPage = 1;
        await LoadAssetsAsync();
    }

    private void RemoveSavedSearch(SavedSearch s) => SavedSearches.Remove(s);

    public class SavedSearch
    {
        public string Name { get; set; } = string.Empty;
        public string Query { get; set; } = string.Empty;
        public List<string> FileTypes { get; set; } = new();
        public List<string> TagIds { get; set; } = new();
        public List<AssetWorkflowState> States { get; set; } = new();
        public string DateRange { get; set; } = string.Empty;
        public string Sort { get; set; } = "newest";
    }
}


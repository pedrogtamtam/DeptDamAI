@page "/Assets/Upload"
@using DeptDam.Data
@using DeptDam.Models
@using DeptDam.Services
@using DeptDam.Services.Storage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAssetService AssetService
@inject NavigationManager NavManager

<PageTitle>Upload Asset</PageTitle>

<h3>Upload Asset</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div>
                    <div class="mb-4">
                        <div class="upload-drop-zone p-5 text-center bg-light rounded-4 border border-2 border-dashed position-relative">
                            <i class="bi bi-cloud-arrow-up display-1 text-primary opacity-50 mb-3"></i>
                            <h4 class="fw-bold">Drag and drop files here</h4>
                            <p class="text-muted mb-0">or click to browse from your computer (Max 50MB per file)</p>
                            <InputFile OnChange="LoadFiles" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" multiple style="cursor: pointer;" />
                        </div>
                    </div>

                    @if (isUploading)
                    {
                        <div class="progress mb-3">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                        </div>
                        <p class="text-muted">Uploading... Please wait.</p>
                    }
                    else if (selectedFiles.Any())
                    {
                        <ul class="list-group mb-3">
                            @foreach (var file in selectedFiles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@file.Name</strong><br/>
                                        <small class="text-muted">@file.ContentType</small>
                                    </div>
                                    <span class="badge bg-secondary rounded-pill">@((file.Size / 1024.0 / 1024.0).ToString("0.00")) MB</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="useAiToggle" @bind="useAi" />
                        <label class="form-check-label" for="useAiToggle">
                            <i class="bi bi-robot me-1"></i> Run AI analysis after upload
                        </label>
                        <div class="form-text">When enabled, AI will auto-tag the asset, extract text and detect faces. Adds a few seconds per file.</div>
                    </div>
                    <button class="btn btn-primary" @onclick="HandleSubmit" disabled="@(!selectedFiles.Any() || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Upload to DAM
                    </button>
                    <a href="/Assets" class="btn btn-outline-secondary ms-2">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<IBrowserFile> selectedFiles = new();
    private bool isUploading = false;
    private bool useAi = false;
    private string? errorMessage;
    private int processedCount = 0;
    private int totalCount = 0;

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        selectedFiles.Clear();
        
        var files = e.GetMultipleFiles(maximumFileCount: 100);
        foreach (var file in files)
        {
             if (file.Size > 50 * 1024 * 1024)
             {
                 errorMessage = $"File '{file.Name}' exceeds maximum allowed size of 50MB and was skipped.";
             }
             else
             {
                 selectedFiles.Add(file);
             }
        }

        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (!selectedFiles.Any()) return;

        isUploading = true;
        errorMessage = null;
        processedCount = 0;
        totalCount = selectedFiles.Count;
        StateHasChanged();

        try
        {
            long maxAllowedSize = 50 * 1024 * 1024;
            
            foreach (var file in selectedFiles)
            {
                try 
                {
                    await using var stream = file.OpenReadStream(maxAllowedSize);
                    await AssetService.CreateAssetAsync(stream, file.Name, file.ContentType, useAi);
                }
                catch (InvalidOperationException dupEx)
                {
                     Console.WriteLine($"Skipped duplicate: {dupEx.Message}");
                     if (errorMessage == null) errorMessage = "";
                     errorMessage += $"'{file.Name}' was skipped (duplicate). ";
                }
                catch (Exception ex)
                {
                     Console.WriteLine($"Error uploading {file.Name}: {ex.Message}");
                     if (errorMessage == null) errorMessage = "";
                     errorMessage += $"'{file.Name}' failed to upload. ";
                }
                finally
                {
                     processedCount++;
                     StateHasChanged();
                }
            }

            if (errorMessage == null)
            {
                NavManager.NavigateTo("/Assets");
            }
            else
            {
                selectedFiles.Clear();
            }
        }
        finally
        {
            isUploading = false;
        }
    }
}

<style>
    .upload-drop-zone {
        transition: all 0.3s ease;
        border-color: #dee2e6 !important;
    }
    .upload-drop-zone:hover, .upload-drop-zone:focus-within {
        background-color: #f8f9fa !important;
        border-color: var(--bs-primary) !important;
    }
</style>

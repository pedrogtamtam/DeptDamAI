@page "/share/{Token}"
@using DeptDam.Data
@using DeptDam.Models
@using DeptDam.Services.Storage
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IStorageProvider StorageProvider

<PageTitle>Shared Asset - DeptDam</PageTitle>

<div class="min-vh-100 d-flex flex-column" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    
    <!-- Header bar -->
    <nav class="navbar navbar-expand-lg navbar-dark px-4 py-3" style="background: linear-gradient(90deg, #1e3a5f 0%, #2563eb 100%);">
        <a class="navbar-brand fw-bold fs-4" href="/">
            <i class="bi bi-box-seam me-2"></i>DeptDam
        </a>
        <span class="ms-auto text-white-50 small"><i class="bi bi-share me-1"></i>Shared Asset Link</span>
    </nav>

    <div class="container py-5 flex-grow-1">
        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted">Loading shared asset…</p>
                </div>
            </div>
        }
        else if (!IsValid)
        {
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-4 text-center">
                    <div class="card border-0 shadow-sm rounded-4 p-5">
                        <i class="bi bi-shield-x display-3 text-danger mb-3"></i>
                        <h2 class="fw-bold">Link Unavailable</h2>
                        <p class="text-muted">@ErrorMessage</p>
                        <a href="/" class="btn btn-primary mt-3">Go to Homepage</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center g-4">
                <!-- Asset Preview -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        @if (Link!.Asset!.ContentType.StartsWith("image/"))
                        {
                            <div class="text-center bg-dark p-3" style="min-height:400px; display:flex; align-items:center; justify-content:center;">
                                <img src="/api/media/@Link.Asset.TenantId/@Link.Asset.StorageKey"
                                     class="img-fluid rounded-3 shadow"
                                     style="max-height: 500px; object-fit: contain;"
                                     alt="@Link.Asset.OriginalFileName" />
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center bg-light">
                                <i class="bi bi-file-earmark-fill display-1 text-secondary"></i>
                                <p class="mt-3 text-muted">@Link.Asset.ContentType</p>
                            </div>
                        }
                        <div class="card-body p-4">
                            <h1 class="h4 fw-bold mb-1">@Link.Asset.OriginalFileName</h1>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-hdd me-1"></i>@((Link.Asset.SizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Info + Download -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4">Asset Details</h5>

                            <div class="mb-3">
                                <span class="text-muted small fw-bold d-block">FILE TYPE</span>
                                <span class="badge bg-secondary mt-1">@Link.Asset.ContentType</span>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small fw-bold d-block">SHARED BY</span>
                                <span class="small">@(Link.Label ?? "Shared Asset")</span>
                            </div>

                            @if (Link.ExpiresAt.HasValue)
                            {
                                <div class="mb-3">
                                    <span class="text-muted small fw-bold d-block">LINK EXPIRES</span>
                                    <span class="small text-warning">
                                        <i class="bi bi-clock me-1"></i>
                                        @Link.ExpiresAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <span class="text-muted small fw-bold d-block">LINK EXPIRES</span>
                                    <span class="small text-success"><i class="bi bi-infinity me-1"></i>Never</span>
                                </div>
                            }

                            @if (Link.Asset.Tags.Any())
                            {
                                <div class="mb-4">
                                    <span class="text-muted small fw-bold d-block mb-2">TAGS</span>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var at in Link.Asset.Tags)
                                        {
                                            <span class="badge rounded-pill bg-info text-dark px-3 py-2">@at.Tag?.Name</span>
                                        }
                                    </div>
                                </div>
                            }

                            <hr />

                            <a href="/api/media/@Link.Asset.TenantId/@Link.Asset.StorageKey"
                               class="btn btn-primary w-100 py-3"
                               download="@Link.Asset.OriginalFileName">
                                <i class="bi bi-download me-2"></i>Download Original
                            </a>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 bg-light">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-0 text-center">
                                <i class="bi bi-info-circle me-1"></i>
                                This file was shared via a secure link. Please do not redistribute without permission.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool IsLoading = true;
    private bool IsValid = false;
    private string ErrorMessage = "This link is invalid, has expired, or has been revoked.";
    private ShareLink? Link;

    protected override async Task OnInitializedAsync()
    {
        // NOTE: We must bypass the tenant query filter here since this is a public URL.
        // We use IgnoreQueryFilters() to look up the token globally.
        Link = await DbContext.ShareLinks
            .IgnoreQueryFilters()
            .Include(sl => sl.Asset)
                .ThenInclude(a => a!.Tags)
                    .ThenInclude(at => at.Tag)
            .FirstOrDefaultAsync(sl => sl.Token == Token);

        if (Link == null)
        {
            ErrorMessage = "This link does not exist.";
        }
        else if (Link.IsRevoked)
        {
            ErrorMessage = "This link has been revoked by its owner.";
        }
        else if (Link.IsExpired)
        {
            ErrorMessage = "This link has expired.";
        }
        else
        {
            IsValid = true;
        }

        IsLoading = false;
    }
}

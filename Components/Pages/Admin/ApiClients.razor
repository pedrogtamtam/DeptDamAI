@page "/Admin/ApiClients"
@using DeptDam.Models
@using DeptDam.Data
@using DeptDam.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject ApiKeyService ApiKeyService
@inject ITenantService TenantService
@inject IPermissionService PermissionService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>API Clients</PageTitle>

<h3>API Clients</h3>

<div class="row mb-4">
    <PermissionView Permission="@AppPermissions.SettingsManage">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create New API Client</div>
                <div class="card-body">
                    <EditForm Model="NewClientModel" OnValidSubmit="CreateClient">
                        <DataAnnotationsValidator />
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="NewClientModel.Name" class="form-control" autocomplete="off" placeholder="Client Name" />
                            <label>Client Name</label>
                            <ValidationMessage For="() => NewClientModel.Name" class="text-danger" />
                        </div>
                        <button type="submit" class="btn btn-primary">Generate Keys</button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Development Tools</div>
                <div class="card-body d-flex flex-column justify-content-center align-items-center" style="min-height: 120px;">
                    <p class="text-muted small text-center mb-3">Download a Postman collection to start integrating with our API.</p>
                    <button class="btn btn-outline-primary" @onclick="DownloadPostmanCollection">
                        <i class="bi bi-download me-2"></i> Download Postman Collection
                    </button>
                </div>
            </div>
        </div>
    </PermissionView>
</div>


@if (NewlyGeneratedSecret != null)
{
    <div class="alert alert-warning mb-4">
        <h4 class="alert-heading">Keep this safe!</h4>
        <p>This is your Client Secret. You will <strong>never</strong> be able to see it again after changing pages.</p>
        <hr>
        <p class="mb-0"><strong>Client ID:</strong> <code>@NewlyGeneratedClientId</code></p>
        <p class="mb-0 mt-2"><strong>Client Secret:</strong> <code>@NewlyGeneratedSecret</code></p>
    </div>
}

<h4>Active Clients</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Client ID</th>
            <th>Created At</th>
            <PermissionView Permission="@AppPermissions.SettingsManage">
                <th>Action</th>
            </PermissionView>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Clients)
        {
            <tr>
                <td>@client.Name</td>
                <td><code>@client.ClientId</code></td>
                <td>@client.CreatedAt.ToLocalTime().ToString("g")</td>
                <PermissionView Permission="@AppPermissions.SettingsManage">
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => RevokeClient(client)">Revoke</button>
                    </td>
                </PermissionView>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ApiClient> Clients = new();
    private CreateClientViewModel NewClientModel { get; set; } = new();
    private string? NewlyGeneratedClientId;
    private string? NewlyGeneratedSecret;

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        Clients = await DbContext.ApiClients.OrderByDescending(c => c.CreatedAt).ToListAsync();
    }

    private async Task CreateClient()
    {
        var keys = ApiKeyService.GenerateCredentials();
        var hash = ApiKeyService.HashSecret(keys.ClientSecret);

        var newClient = new ApiClient
        {
            Name = NewClientModel.Name,
            ClientId = keys.ClientId,
            ClientSecretHash = hash,
            TenantId = TenantService.GetCurrentTenantId()!
        };

        DbContext.ApiClients.Add(newClient);
        await DbContext.SaveChangesAsync();

        NewlyGeneratedClientId = keys.ClientId;
        NewlyGeneratedSecret = keys.ClientSecret;
        NewClientModel = new();
        
        await LoadClients();
    }

    private async Task RevokeClient(ApiClient client)
    {
        DbContext.ApiClients.Remove(client);
        await DbContext.SaveChangesAsync();
        await LoadClients();
    }

    private async Task DownloadPostmanCollection()
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        var postmanCollection = new
        {
            info = new
            {
                name = "DeptDam API",
                _postman_id = Guid.NewGuid().ToString(),
                schema = "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
            },
            item = new object[]
            {
                new {
                    name = "Authentication",
                    item = new object[] {
                        new {
                            name = "Get Access Token",
                            request = new {
                                method = "POST",
                                body = new {
                                    mode = "urlencoded",
                                    urlencoded = new[] {
                                        new { key = "grant_type", value = "client_credentials", type = "text" },
                                        new { key = "client_id", value = "{{client_id}}", type = "text" },
                                        new { key = "client_secret", value = "{{client_secret}}", type = "text" }
                                    }
                                },
                                url = new {
                                    raw = "{{base_url}}/connect/token",
                                    host = new[] { "{{base_url}}" },
                                    path = new[] { "connect", "token" }
                                },
                                description = "Request a JWT access token using client credentials."
                            }
                        }
                    }
                },
                new {
                    name = "Assets",
                    item = new object[] {
                        new {
                            name = "List Assets",
                            request = new {
                                auth = new {
                                    type = "bearer",
                                    bearer = new[] { new { key = "token", value = "{{access_token}}", type = "string" } }
                                },
                                method = "GET",
                                url = new {
                                    raw = "{{base_url}}/api/assets?page=1&pageSize=50",
                                    host = new[] { "{{base_url}}" },
                                    path = new[] { "api", "assets" },
                                    query = new[] {
                                        new { key = "page", value = "1" },
                                        new { key = "pageSize", value = "50" }
                                    }
                                }
                            }
                        },
                        new {
                            name = "Get Asset Details",
                            request = new {
                                auth = new {
                                    type = "bearer",
                                    bearer = new[] { new { key = "token", value = "{{access_token}}", type = "string" } }
                                },
                                method = "GET",
                                url = new {
                                    raw = "{{base_url}}/api/assets/{{asset_id}}",
                                    host = new[] { "{{base_url}}" },
                                    path = new[] { "api", "assets", "{{asset_id}}" }
                                }
                            }
                        },
                        new {
                             name = "Upload Asset",
                             request = new {
                                 auth = new {
                                     type = "bearer",
                                     bearer = new[] { new { key = "token", value = "{{access_token}}", type = "string" } }
                                 },
                                 method = "POST",
                                 body = new {
                                     mode = "formdata",
                                     formdata = new[] {
                                         new { key = "file", type = "file", src = "", description = "The file to upload" }
                                     }
                                 },
                                 url = new {
                                     raw = "{{base_url}}/api/assets/upload",
                                     host = new[] { "{{base_url}}" },
                                     path = new[] { "api", "assets", "upload" }
                                 }
                             }
                        }
                    }
                }
            },
            variable = new[] {
                new { key = "base_url", value = baseUrl, type = "string" },
                new { key = "client_id", value = NewlyGeneratedClientId ?? "", type = "string" },
                new { key = "client_secret", value = NewlyGeneratedSecret ?? "", type = "string" },
                new { key = "access_token", value = "", type = "string" },
                new { key = "asset_id", value = "", type = "string" }
            }
        };

        var json = System.Text.Json.JsonSerializer.Serialize(postmanCollection, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Admin/ApiClients.razor.js");
        await module.InvokeVoidAsync("downloadFile", "DeptDam-API.postman_collection.json", json);
    }

    public class CreateClientViewModel

    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(50)]
        public string Name { get; set; } = string.Empty;
    }
}

@page "/Admin/Tags"
@using DeptDam.Data
@using DeptDam.Models
@using DeptDam.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "DAM_Admin")]
@inject ApplicationDbContext DbContext
@inject ITenantService TenantService
@rendermode InteractiveServer

<PageTitle>Tag Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Tag Management</h3>
        <p class="text-muted small mb-0">Manage global tags for your organization's assets.</p>
    </div>
    <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
        <i class="bi bi-tag-fill me-1"></i> @AllTags.Count Total Tags
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Tag Name</th>
                    <th>Assets Used</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!AllTags.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-tags display-6 opacity-25 d-block mb-2"></i>
                            No tags found. Tags are created when added to assets.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tag in AllTags)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border px-3 py-2">
                                    <i class="bi bi-hash text-muted me-1"></i>@tag.Name
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">used in @tag.AssetCount assets</span>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTag(tag)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<TagSummary> AllTags = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        var tenantId = TenantService.GetCurrentTenantId();
        AllTags = await DbContext.Tags
            .Where(t => t.TenantId == tenantId)
            .Select(t => new TagSummary
            {
                Id = t.Id,
                Name = t.Name,
                AssetCount = DbContext.AssetTags.Count(at => at.TagId == t.Id)
            })
            .OrderBy(t => t.Name)
            .ToListAsync();
    }

    private async Task DeleteTag(TagSummary tag)
    {
        var t = await DbContext.Tags.FindAsync(tag.Id);
        if (t != null)
        {
            DbContext.Tags.Remove(t);
            await DbContext.SaveChangesAsync();
            await LoadTags();
        }
    }

    public class TagSummary
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int AssetCount { get; set; }
    }
}

@page "/Admin/Transformations"
@using DeptDam.Data
@using DeptDam.Models
@using DeptDam.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using System.IO
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject ITenantService TenantService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<PageTitle>Transformations</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-magic me-2 text-primary"></i>Transformations</h1>
        <p class="text-secondary small mb-0">Define reusable image size, format, and processing rules for asset delivery.</p>
    </div>
    <div class="d-flex gap-2">
        <PermissionView Permission="@AppPermissions.SettingsManage">
            <button class="btn btn-outline-danger" @onclick="ClearCache">
                <i class="bi bi-trash3 me-1"></i> Clear Cache
            </button>
            <button class="btn btn-primary" @onclick="AddNew">
                <i class="bi bi-plus-lg me-1"></i> New Transformation
            </button>
        </PermissionView>
    </div>
</div>

@if (showAlert)
{
    <div class="alert alert-@alertClass alert-dismissible fade show" role="alert">
        @alertMessage
        <button type="button" class="btn-close" @onclick="() => showAlert = false"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        @if (!transformations.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 border border-dashed">
                <i class="bi bi-magic display-3 text-muted opacity-25"></i>
                <p class="mt-3 text-secondary">No transformations yet. Create one to enable predefined delivery formats.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Size</th>
                                <th>Format</th>
                                <th>Quality</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transformation in transformations.OrderBy(p => p.SortOrder).ThenBy(p => p.Name))
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@transformation.Name</td>
                                    <td class="text-muted">
                                        @if (transformation.Width.HasValue || transformation.Height.HasValue)
                                        {
                                            @($"{transformation.Width?.ToString() ?? "auto"} x {transformation.Height?.ToString() ?? "auto"}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Original</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary-subtle text-secondary text-uppercase">@transformation.Format</span></td>
                                    <td class="text-muted">@(transformation.Format == "original" ? "-" : $"{transformation.Quality}%")</td>
                                    <td class="text-end pe-4">
                                        <PermissionView Permission="@AppPermissions.SettingsManage">
                                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEdit(transformation)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(transformation)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </PermissionView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (editing != null)
    {
        <PermissionView Permission="@AppPermissions.SettingsManage">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm border-start border-primary border-3">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-pencil-square text-primary me-2"></i>
                            @(string.IsNullOrEmpty(editing.Id) || !transformations.Any(p => p.Id == editing.Id) ? "New Transformation" : "Edit Transformation")
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted text-uppercase">Name</label>
                            <input type="text" class="form-control" @bind="editing.Name" placeholder="Web Thumbnail" maxlength="100" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Width (px)</label>
                                <input type="number" class="form-control" @bind="editing.Width" placeholder="Leave blank = auto" min="1" max="10000" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Height (px)</label>
                                <input type="number" class="form-control" @bind="editing.Height" placeholder="Leave blank = auto" min="1" max="10000" />
                            </div>
                        </div>
                        <div class="form-text mb-3">Set one dimension and leave the other blank to preserve aspect ratio.</div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted text-uppercase">Format</label>
                            <select class="form-select" @bind="editing.Format">
                                <option value="original">Original (no conversion)</option>
                                <option value="jpeg">JPEG</option>
                                <option value="png">PNG</option>
                                <option value="webp">WebP</option>
                            </select>
                        </div>

                        @if (editing.Format != "original")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted text-uppercase">
                                    Quality — @editing.Quality%
                                </label>
                                <input type="range" class="form-range" @bind="editing.Quality" min="10" max="100" step="5" />
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">10% (smallest)</small>
                                    <small class="text-muted">100% (best)</small>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted text-uppercase">Resize Mode</label>
                            <select class="form-select" @bind="editing.ResizeMode">
                                <option value="max">Max (fit within bounds)</option>
                                <option value="crop">Crop (fill bounds)</option>
                                <option value="pad">Pad (add borders)</option>
                                <option value="stretch">Stretch</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-4 mt-2">
                             <div class="col-6">
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="grayCheck" @bind="editing.Grayscale">
                                    <label class="form-check-label small fw-bold text-muted text-uppercase" for="grayCheck">Grayscale</label>
                                </div>
                             </div>
                             <div class="col-6">
                                <div class="form-check form-switch mt-1">
                                    <input class="form-check-input" type="checkbox" id="sepiaCheck" @bind="editing.Sepia">
                                    <label class="form-check-label small fw-bold text-muted text-uppercase" for="sepiaCheck">Sepia</label>
                                </div>
                             </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted text-uppercase d-flex justify-content-between">
                                Brightness <span>(@(editing.Brightness > 0 ? "+" : "")@editing.Brightness%)</span>
                            </label>
                            <input type="range" class="form-range" @bind="editing.Brightness" min="-100" max="100" step="5" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase d-flex justify-content-between">
                                Contrast <span>(@(editing.Contrast > 0 ? "+" : "")@editing.Contrast%)</span>
                            </label>
                            <input type="range" class="form-range" @bind="editing.Contrast" min="-100" max="100" step="5" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase">Sort Order</label>
                            <input type="number" class="form-control" @bind="editing.SortOrder" min="0" />
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary px-4" @onclick="Save" disabled="@string.IsNullOrWhiteSpace(editing.Name)">
                                <i class="bi bi-save me-1"></i> Save
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="() => editing = null">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </PermissionView>
    }
</div>

@code {
private List<Transformation> transformations = new();
private Transformation? editing;
private bool showAlert;
private string alertMessage = "";
private string alertClass = "success";

protected override async Task OnInitializedAsync() => await Load();

private async Task Load()
{
    var tid = TenantService.GetCurrentTenantId();
    if (string.IsNullOrEmpty(tid)) return;
    transformations = await DbContext.Transformations
        .IgnoreQueryFilters()
        .Where(p => p.TenantId == tid)
        .ToListAsync();
}

private void AddNew()
{
    editing = new Transformation
    {
        TenantId = TenantService.GetCurrentTenantId() ?? "",
        Quality = 85
    };
}

    private void StartEdit(Transformation transformation)
    {
        editing = new Transformation
        {
            Id         = transformation.Id,
            TenantId   = transformation.TenantId,
            Name       = transformation.Name,
            Width      = transformation.Width,
            Height     = transformation.Height,
            Format     = transformation.Format,
            Quality    = transformation.Quality,
            ResizeMode = transformation.ResizeMode,
            Grayscale  = transformation.Grayscale,
            Sepia      = transformation.Sepia,
            Brightness = transformation.Brightness,
            Contrast   = transformation.Contrast,
            SortOrder  = transformation.SortOrder
        };
    }

private async Task Save()
{
    if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;

    var existing = transformations.FirstOrDefault(p => p.Id == editing.Id);
    if (existing == null)
    {
        DbContext.Transformations.Add(editing);
    }
        else
        {
            existing.Name       = editing.Name;
            existing.Width      = editing.Width;
            existing.Height     = editing.Height;
            existing.Format     = editing.Format;
            existing.Quality    = editing.Quality;
            existing.ResizeMode = editing.ResizeMode;
            existing.Grayscale  = editing.Grayscale;
            existing.Sepia      = editing.Sepia;
            existing.Brightness = editing.Brightness;
            existing.Contrast   = editing.Contrast;
            existing.SortOrder  = editing.SortOrder;
        }

    await DbContext.SaveChangesAsync();
    editing = null;
    await Load();
    Notify("Transformation saved.", "success");
}

private async Task Delete(Transformation transformation)
{
    DbContext.Transformations.Remove(transformation);
    await DbContext.SaveChangesAsync();
    await Load();
    Notify("Transformation deleted.", "secondary");
}

private void ClearCache()
{
    try
    {
        var cachePath = Path.Combine(Env.WebRootPath, "cache", "transformations");
        if (Directory.Exists(cachePath))
        {
            Directory.Delete(cachePath, true);
            Directory.CreateDirectory(cachePath);
            Notify("Transformation cache cleared.", "success");
        }
        else
        {
            Notify("Cache is already empty.", "info");
        }
    }
    catch (Exception ex)
    {
        Notify($"Error clearing cache: {ex.Message}", "danger");
    }
}

    private void Notify(string msg, string cls) { alertMessage = msg; alertClass = cls; showAlert = true; }
}

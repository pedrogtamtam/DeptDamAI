@page "/Admin/Users"
@using DeptDam.Data
@using DeptDam.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DeptDam.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject ITenantService TenantService
@inject ApplicationDbContext DbContext
@inject ILogger<Users> Logger
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionService PermissionService

<PageTitle>User Management</PageTitle>

<h3>User Management</h3>
<div class="row">
    <PermissionView Permission="@AppPermissions.UsersManage">
        <div class="col-md-4">
            <h4>Invite New User</h4>
            <EditForm Model="InviteModel" OnValidSubmit="InviteUser">
                <DataAnnotationsValidator />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="InviteModel.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                    <label>Email address</label>
                    <ValidationMessage For="() => InviteModel.Email" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Invite</button>
                @if (InviteMessage != null)
                {
                    <div class="alert alert-success mt-2">@InviteMessage</div>
                }
                @if (InviteError != null)
                {
                    <div class="alert alert-danger mt-2">@InviteError</div>
                }
            </EditForm>
        </div>
    </PermissionView>
    <div class="col-md-8">
        <h4>Existing Users & Roles</h4>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Roles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in TenantUsers)
                    {
                        <tr>
                            <td class="align-middle">@user.Email</td>
                            <td class="align-middle">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in GetUserRoles(user))
                                    {
                                        <span class="badge bg-info text-dark">@role</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <PermissionView Permission="@AppPermissions.RolesManage">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" @onclick="() => ToggleDropdown(user.Id)">
                                            Manage Roles
                                        </button>
                                        <div class="dropdown-menu p-3 shadow @(visibleDropdowns.Contains(user.Id) ? "show" : "")" style="min-width: 200px;">
                                            @foreach (var roleName in AllRoleNames)
                                            {
                                                var currentRole = roleName;
                                                @if (currentRole != "SuperAdmin" || IsSuperAdmin)
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="role_@(user.Id)_@(currentRole)" 
                                                               checked="@UserRoles[user.Id].Contains(currentRole)"
                                                               @onchange="@((ChangeEventArgs e) => ToggleRole(user, currentRole, (bool)(e.Value ?? false)))" />
                                                        <label class="form-check-label small" for="role_@(user.Id)_@(currentRole)">
                                                            @currentRole
                                                        </label>
                                                    </div>
                                                }
                                            }

                                        </div>
                                    </div>
                                </PermissionView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private InviteViewModel InviteModel { get; set; } = new();
    private List<ApplicationUser> TenantUsers = new();
    private string? InviteMessage;
    private string? InviteError;
    private bool IsSuperAdmin;
    private List<string> AllRoleNames = new();
    private HashSet<string> visibleDropdowns = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IsSuperAdmin = authState.User.IsInRole("SuperAdmin");
        
        var tenantId = TenantService.GetCurrentTenantId();
        AllRoleNames = await DbContext.Roles
            .OfType<ApplicationRole>()
            .Where(r => r.TenantId == tenantId)
            .OrderBy(r => r.Name)
            .Select(r => r.Name!)
            .ToListAsync();

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        TenantUsers = await DbContext.Users.ToListAsync();
        UserRoles.Clear();
        foreach (var user in TenantUsers)
        {
            var roles = await UserManager.GetRolesAsync(user);
            UserRoles[user.Id] = roles.ToList();
        }
    }

    private Dictionary<string, List<string>> UserRoles = new();

    private List<string> GetUserRoles(ApplicationUser user) => UserRoles.ContainsKey(user.Id) ? UserRoles[user.Id] : new List<string>();

    private void ToggleDropdown(string userId)
    {
        if (visibleDropdowns.Contains(userId))
            visibleDropdowns.Remove(userId);
        else
            visibleDropdowns.Add(userId);
    }

    private async Task ToggleRole(ApplicationUser user, string roleName, bool isChecked)
    {
        if (isChecked)
            await UserManager.AddToRoleAsync(user, roleName);
        else
            await UserManager.RemoveFromRoleAsync(user, roleName);
        
        await LoadUsers();
    }

    private async Task InviteUser()
    {
        InviteMessage = null;
        InviteError = null;

        var user = new ApplicationUser 
        { 
            UserName = InviteModel.Email, 
            Email = InviteModel.Email,
            TenantId = TenantService.GetCurrentTenantId()! 
        };

        var result = await UserManager.CreateAsync(user);

        if (result.Succeeded)
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = Microsoft.AspNetCore.WebUtilities.WebEncoders.Base64UrlEncode(System.Text.Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["Input.Code"] = code, ["Input.Email"] = user.Email });

            InviteMessage = $"User created! (Local dev only) Invite Link: {callbackUrl}";
            
            InviteModel = new();
            await LoadUsers();
        }
        else
        {
            InviteError = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

    public class InviteViewModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}

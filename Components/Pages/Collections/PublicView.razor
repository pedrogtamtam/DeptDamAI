@page "/Public/Collection/{Id}"
@using DeptDam.Data
@using DeptDam.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>@Collection?.Name - Public Media Gallery</PageTitle>

@if (Loading)
{
    <div class="container mt-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="mt-3 fw-light">Preparing your gallery...</h4>
    </div>
}
else if (Collection == null || !Collection.IsPublic)
{
    <div class="container mt-5">
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="card-body">
                <i class="bi bi-shield-lock display-1 text-danger opacity-25 mb-4"></i>
                <h2 class="fw-bold">Access Denied</h2>
                <p class="text-secondary lead mb-0">This media collection is either private or does not exist.</p>
                <hr class="w-25 mx-auto my-4">
                <p class="small text-muted">Please contact the owner if you believe this is an error.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-5 bg-white min-vh-100">
        <div class="container">
            <header class="text-center mb-5 animate-fade-in">
                <div class="badge bg-primary-subtle text-primary mb-3 px-3 py-2 rounded-pill fw-normal letter-spacing-1">MEDIA GALLERY</div>
                <h1 class="display-4 fw-bold mb-3">@Collection.Name</h1>
                @if (!string.IsNullOrEmpty(Collection.Description))
                {
                    <p class="lead text-secondary mx-auto mb-0" style="max-width: 700px;">@Collection.Description</p>
                }
            </header>

            @if (!Collection.Assets.Any() && !dynamicAssets.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-images h1 text-muted opacity-25"></i>
                    <p class="mt-3 text-secondary">No assets found in this collection.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var asset in AllAssets)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden gallery-card">
                                <div class="card-img-wrap bg-light d-flex align-items-center justify-content-center" style="height: 280px; position: relative;">
                                    @if (asset.ContentType.StartsWith("image/"))
                                    {
                                        <img src="/api/media/@asset.TenantId/@asset.StorageKey?w=800" class="gallery-img" alt="@asset.OriginalFileName" />
                                    }
                                    else
                                    {
                                        <div class="text-center">
                                            <i class="bi bi-file-earmark-fill display-2 text-secondary opacity-50"></i>
                                            <div class="small text-muted mt-2">@asset.ContentType.Split('/').Last().ToUpper() File</div>
                                        </div>
                                    }
                                    
                                    @if (!Collection.Assets.Any(ca => ca.AssetId == asset.Id))
                                    {
                                        <div class="position-absolute top-0 start-0 m-3">
                                            <span class="badge bg-primary rounded-pill shadow-sm"><i class="bi bi-magic me-1"></i> Smart Item</span>
                                        </div>
                                    }
                                </div>
                                <div class="card-body p-4">
                                    <h6 class="card-title text-truncate mb-3 fw-bold" title="@asset.OriginalFileName">@asset.OriginalFileName</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">@((asset.SizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</span>
                                        <a href="/api/media/@asset.TenantId/@asset.StorageKey" download="@asset.OriginalFileName" class="btn btn-primary rounded-pill px-4">
                                            <i class="bi bi-download me-1"></i> Download
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            
            <footer class="text-center mt-5 pt-5 border-top border-light">
                <p class="text-muted small">Powered by <span class="fw-bold text-dark">DeptDam</span> Enterprise Digital Asset Management</p>
            </footer>
        </div>
    </div>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .gallery-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .gallery-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
    }
    .gallery-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.5s ease;
        padding: 5px;
    }
    .gallery-card:hover .gallery-img {
        transform: scale(1.02);
    }
    .card-img-wrap {
        overflow: hidden;
    }
    .letter-spacing-1 {
        letter-spacing: 0.1rem;
    }
</style>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Collection? Collection;
    private List<Asset> dynamicAssets = new();
    private List<Asset> AllAssets => (Collection?.Assets.Select(ca => ca.Asset!).Concat(dynamicAssets)).ToList();
    private bool Loading = true;

    protected override async Task OnInitializedAsync()
    {
        Loading = true;
        
        // Use IgnoreQueryFilters for public sharing
        Collection = await DbContext.Collections
            .IgnoreQueryFilters()
            .Include(c => c.DynamicTags)
                .ThenInclude(ct => ct.Tag)
            .Include(c => c.Assets)
                .ThenInclude(ca => ca.Asset)
            .FirstOrDefaultAsync(c => c.Id == Id);

        if (Collection != null && Collection.IsPublic && Collection.DynamicTags.Any())
        {
            var tagIds = Collection.DynamicTags.Select(ct => ct.TagId).ToList();
            var manualAssetIds = Collection.Assets.Select(ca => ca.AssetId).ToList();

            // IgnoreQueryFilters to find ALL assets that match the tags (public view)
            dynamicAssets = await DbContext.AssetTags
                .IgnoreQueryFilters()
                .Where(at => tagIds.Contains(at.TagId) && !manualAssetIds.Contains(at.AssetId))
                .Select(at => at.Asset!)
                .Distinct()
                .ToListAsync();
        }
            
        Loading = false;
    }
}


@page "/Collections"
@using DeptDam.Models
@using DeptDam.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext

<PageTitle>Collections</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5 animate-fade-in">
    <div>
        <h1 class="h2 mb-1 fw-bold">Collections</h1>
        <p class="text-secondary small mb-0">Group and share your assets through static or dynamic collections.</p>
    </div>
    <a href="/Collections/Create" class="btn btn-primary px-4 d-flex align-items-center">
        <i class="bi bi-plus-lg me-2"></i> Create New
    </a>
</div>

@if (collectionsList == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!collectionsList.Any())
{
    <div class="text-center py-5 bg-light rounded-4 border border-dashed animate-fade-in">
        <div class="mb-4">
            <i class="bi bi-collection display-1 text-muted opacity-25"></i>
        </div>
        <h4 class="fw-bold">No collections yet</h4>
        <p class="text-secondary mb-4">Start by creating your first collection to organize your library.</p>
        <a href="/Collections/Create" class="btn btn-primary px-4">Create Collection</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5 animate-fade-in">
        @foreach (var collection in collectionsList)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden collection-card ripple" @onclick='() => NavigateToDetail(collection.Id)'>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-primary-subtle text-primary p-2 rounded-3">
                                <i class="bi bi-folder2-open h4 mb-0"></i>
                            </div>
                            @if (collection.IsPublic)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">
                                    <i class="bi bi-globe me-1"></i> Public
                                </span>
                            }
                        </div>
                        
                        <h5 class="card-title fw-bold mb-2">@collection.Name</h5>
                        <p class="card-text text-secondary small text-truncate-2 mb-4" style="height: 2.5rem;">@collection.Description</p>
                        
                        <div class="d-flex align-items-center gap-3 text-muted small">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-images me-1"></i>
                                <span>@collection.Assets.Count</span>
                            </div>
                            @if (collection.DynamicTags.Any())
                            {
                                <div class="d-flex align-items-center text-primary">
                                    <i class="bi bi-magic me-1"></i>
                                    <span>Smart</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px;">
                                <i class="bi bi-person text-secondary" style="font-size: 0.8rem;"></i>
                            </div>
                            <span class="text-muted" style="font-size: 0.75rem;">@(collection.CreatedBy?.Email?.Split('@')[0] ?? "User")</span>
                        </div>
                        <a href="/Collections/@collection.Id" class="btn btn-link btn-sm text-decoration-none p-0 fw-bold">
                            Open <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .collection-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .collection-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    @inject NavigationManager NavigationManager
    private List<Collection>? collectionsList;

    protected override async Task OnInitializedAsync()
    {
        collectionsList = await DbContext.Collections
            .Include(c => c.CreatedBy)
            .Include(c => c.Assets)
            .Include(c => c.DynamicTags)
            .OrderByDescending(c => c.CreatedAt)
            .ToListAsync();
    }

    private void NavigateToDetail(string id)
    {
        NavigationManager.NavigateTo($"/Collections/{id}");
    }
}


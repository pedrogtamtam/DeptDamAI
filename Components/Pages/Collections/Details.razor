@page "/Collections/{Id}"
@using DeptDam.Models
@using DeptDam.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using DeptDam.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@inject IPermissionService PermissionService

<PageTitle>Collection Details - @Collection?.Name</PageTitle>

@if (Collection == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <PermissionView Permission="@AppPermissions.CollectionsView">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/Collections">Collections</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Collection.Name</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h2 mb-0">@Collection.Name</h1>
                    @if (Collection.IsPublic)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-globe me-1"></i> Public
                        </span>
                    }
                </div>
                <p class="text-secondary mb-2">@Collection.Description</p>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small"><i class="bi bi-clock me-1"></i> Created @Collection.CreatedAt.ToLocalTime().ToString("d")</span>
                    <span class="text-muted small">•</span>
                    <span class="text-muted small"><i class="bi bi-person me-1"></i> @(Collection.CreatedBy?.Email ?? "System")</span>
                    
                    @if (Collection.DynamicTags.Any())
                    {
                        <span class="text-muted small">•</span>
                        <i class="bi bi-magic text-primary small" title="Smart Collection Rules"></i>
                        @foreach (var dynamicTag in Collection.DynamicTags)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill fw-normal">#@dynamicTag.Tag?.Name</span>
                        }
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (Collection.IsPublic)
                {
                    <a href="/Public/Collection/@Collection.Id" target="_blank" class="btn btn-outline-info">
                        <i class="bi bi-share me-1"></i> Share
                    </a>
                }
                <PermissionView Permission="@AppPermissions.CollectionsManage">
                    <button class="btn @(Collection.IsPublic ? "btn-outline-warning" : "btn-outline-primary")" @onclick="TogglePublicState">
                        <i class="bi @(Collection.IsPublic ? "bi-lock" : "bi-unlock") me-1"></i>
                        @(Collection.IsPublic ? "Private" : "Public")
                    </button>
                    <button class="btn btn-primary" @onclick="ShowAddAssetModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Manual
                    </button>
                </PermissionView>
            </div>
        </div>

        @if (!Collection.Assets.Any() && !dynamicAssets.Any())
        {
            <div class="text-center py-5 bg-light rounded-4 border border-dashed">
                <i class="bi bi-collection display-1 text-muted opacity-25 mb-3 d-block"></i>
                <h5>This collection is empty</h5>
                <p class="text-secondary mb-4">Add assets manually or configure smart tags to populate it.</p>
                <button class="btn btn-primary" @onclick="ShowAddAssetModal">Add Assets Now</button>
            </div>
        }
        else
        {
            @if (Collection.Assets.Any())
            {
                <h5 class="mb-3 text-secondary small fw-bold text-uppercase letter-spacing-05">Manual Assets (@Collection.Assets.Count)</h5>
                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
                    @foreach (var ca in Collection.Assets)
                    {
                        <div class="col">
                            <AssetCard Asset="ca.Asset" OnRemove="() => RemoveAsset(ca)" IsDeletable="true" />
                        </div>
                    }
                </div>
            }

            @if (dynamicAssets.Any())
            {
                <h5 class="mb-3 text-secondary small fw-bold text-uppercase letter-spacing-05">
                    <i class="bi bi-magic text-primary me-2"></i>Smart Assets (@dynamicAssets.Count)
                    <span class="text-muted fw-normal ms-2 text-lowercase">(Matched by tags)</span>
                </h5>
                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
                    @foreach (var asset in dynamicAssets)
                    {
                        <div class="col">
                            <AssetCard Asset="asset" IsDeletable="false" />
                        </div>
                    }
                </div>
            }
        }

        @if (showingAddAssetModal)
        {
            <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.4); backdrop-filter: blur(4px);">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header border-bottom-0 ps-4 pt-4">
                            <h5 class="modal-title fw-bold">Add Assets to Collection</h5>
                            <button type="button" class="btn-close" @onclick="CloseAddAssetModal"></button>
                        </div>
                        <div class="modal-body px-4">
                            <p class="text-secondary small mb-4">Select assets from your library to add them manually to @Collection.Name.</p>
                            @if (AvailableAssets == null)
                            {
                                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                            }
                            else if (!AvailableAssets.Any())
                            {
                                <div class="text-center py-4 text-muted">All assets are already in this collection.</div>
                            }
                            else
                            {
                                <div class="row row-cols-2 row-cols-md-3 g-3">
                                    @foreach (var asset in AvailableAssets)
                                    {
                                        <div class="col">
                                            <div class="card h-100 border-0 bg-light-hover cursor-pointer ripple" @onclick="() => AddAssetToCollection(asset)">
                                                <div class="card-img-top bg-white d-flex align-items-center justify-content-center border" style="height: 120px; overflow: hidden; border-radius: 8px;">
                                                    @if (asset.ContentType.StartsWith("image/"))
                                                    {
                                                        <img src="/api/media/@asset.TenantId/@asset.StorageKey?w=200&h=200" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-earmark-fill h1 text-muted opacity-50 mb-0"></i>
                                                    }
                                                </div>
                                                <div class="card-body p-2 text-center">
                                                    <small class="d-block text-truncate fw-medium" title="@asset.OriginalFileName">@asset.OriginalFileName</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="modal-footer border-top-0 pb-4 pe-4">
                            <button type="button" class="btn btn-outline-secondary px-4" @onclick="CloseAddAssetModal">Done</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </PermissionView>

    <AuthorizeView>
        <NotAuthorized>
            <div class="alert alert-warning">You do not have permission to view collection details.</div>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Collection? Collection;
    private List<Asset> dynamicAssets = new();
    private bool showingAddAssetModal = false;
    private List<Asset>? AvailableAssets;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollectionDataAsync();
    }

    private async Task LoadCollectionDataAsync()
    {
        Collection = await DbContext.Collections
            .Include(c => c.CreatedBy)
            .Include(c => c.DynamicTags)
                .ThenInclude(ct => ct.Tag)
            .Include(c => c.Assets)
                .ThenInclude(ca => ca.Asset)
            .FirstOrDefaultAsync(c => c.Id == Id);

        if (Collection != null && Collection.DynamicTags.Any())
        {
            var tagIds = Collection.DynamicTags.Select(ct => ct.TagId).ToList();
            var manualAssetIds = Collection.Assets.Select(ca => ca.AssetId).ToList();

            // Find assets that have at least one of these tags and are NOT manually in the collection
            dynamicAssets = await DbContext.AssetTags
                .Where(at => tagIds.Contains(at.TagId) && !manualAssetIds.Contains(at.AssetId))
                .Select(at => at.Asset!)
                .Distinct()
                .ToListAsync();
        }
        else
        {
            dynamicAssets = new();
        }
    }

    private async Task TogglePublicState()
    {
        if (Collection == null) return;
        Collection.IsPublic = !Collection.IsPublic;
        await DbContext.SaveChangesAsync();
    }


    private async Task RemoveAsset(CollectionAsset ca)
    {
        DbContext.CollectionAssets.Remove(ca);
        await DbContext.SaveChangesAsync();
        await LoadCollectionDataAsync();
    }

    private async Task ShowAddAssetModal()
    {
        if (Collection == null) return;
        var existingAssetIds = Collection.Assets.Select(ca => ca.AssetId).ToList();
        
        AvailableAssets = await DbContext.Assets
            .Where(a => !existingAssetIds.Contains(a.Id))
            .OrderByDescending(a => a.UploadedAt)
            .Take(50)
            .ToListAsync();
            
        showingAddAssetModal = true;
    }

    private void CloseAddAssetModal() => showingAddAssetModal = false;

    private async Task AddAssetToCollection(Asset asset)
    {
        if (Collection == null) return;

        var collectionAsset = new CollectionAsset
        {
            CollectionId = Collection.Id,
            AssetId = asset.Id,
            TenantId = Collection.TenantId
        };

        DbContext.CollectionAssets.Add(collectionAsset);
        await DbContext.SaveChangesAsync();
        await LoadCollectionDataAsync();
        AvailableAssets?.Remove(asset);
    }
}

